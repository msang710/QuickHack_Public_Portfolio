/// QuickHack model: 응답 유실 등 결과가 불명확한 쓰기 호출을 대조 완료까지 추적합니다.
model carrier_reconciliation_works {
  revision                       Int                                   @default(0)
  carrier_reconciliation_work_id Int                                   @id @default(autoincrement())
  carrier_code                   String
  operation_type                 String
  lookup_key_type                String
  lookup_key_value               String
  reconciliation_status          String                                @default("PENDING")
  api_call_log_id                Int?
  attempt_count                  Int                                   @default(0)
  reason                         String?
  last_error_message             String?
  resolved_at                    DateTime?                             @db.Timestamptz(3)
  created_at                     DateTime                              @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime                              @default(now()) @updatedAt @db.Timestamptz(3)
  api_call_log                   carrier_api_call_logs?                @relation(fields: [api_call_log_id], references: [carrier_api_call_log_id], onDelete: SetNull)
  carrier_registration_works     carrier_shipment_registration_works[]

  @@unique([carrier_code, operation_type, lookup_key_type, lookup_key_value], map: "uq_carrier_reconciliation_lookup")
  @@index([reconciliation_status], map: "idx_carrier_reconciliation_status")
  @@index([api_call_log_id], map: "idx_carrier_reconciliation_api_call")
  @@index([updated_at], map: "idx_carrier_reconciliation_updated")
}

/// QuickHack PostgreSQL singleton used to invalidate server-owned credentials after restore.
model server_instance_state {
  singleton_key  String   @id @default("QUICKHACK")
  instance_epoch Int      @default(1)
  revision       Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

/// QuickHack cross-domain idempotency record. Domain rules remain in their owning service.
model domain_operation_keys {
  operation_id   String   @id @db.Uuid
  scope          String
  operation_key  String
  aggregate_type String
  aggregate_id   String
  request_digest String
  result_digest  String?
  status         String   @default("COMMITTED")
  created_at     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([scope, operation_key], map: "uq_domain_operation_keys_scope_key")
  @@index([aggregate_type, aggregate_id], map: "idx_domain_operation_keys_aggregate")
  @@index([created_at], map: "idx_domain_operation_keys_created_at")
}

/// Durable external command registered by a business transaction.
model integration_commands {
  integration_command_id String                         @id @db.Uuid
  provider               String
  operation_type         String
  operation_key          String                         @unique(map: "uq_integration_commands_operation_key")
  target_snapshot        Json                           @db.JsonB
  request_payload        Json?                          @db.JsonB
  request_digest         String
  command_status         String                         @default("PENDING")
  lease_token            String?                        @db.Uuid
  claim_generation       Int                            @default(0)
  locked_until           DateTime?                      @db.Timestamptz(3)
  created_at             DateTime                       @default(now()) @db.Timestamptz(3)
  updated_at             DateTime                       @default(now()) @updatedAt @db.Timestamptz(3)
  attempts               integration_command_attempts[]
  evidences              integration_evidences[]
  sales_channel_attempt  sales_channel_write_request_attempts?

  @@index([provider, command_status, created_at], map: "idx_integration_commands_provider_status")
  @@index([command_status, locked_until], map: "idx_integration_commands_claim")
}

/// One dispatch attempt. HTTP runs outside the transaction that owns this row.
model integration_command_attempts {
  integration_command_attempt_id String                  @id @db.Uuid
  integration_command_id         String                  @db.Uuid
  attempt_no                     Int
  dispatch_status                String                  @default("CREATED")
  request_dispatched_at          DateTime?               @db.Timestamptz(3)
  response_received_at           DateTime?               @db.Timestamptz(3)
  http_status                    Int?
  provider_code                  String?
  error_code                     String?
  error_message                  String?
  created_at                     DateTime                @default(now()) @db.Timestamptz(3)
  command                        integration_commands    @relation(fields: [integration_command_id], references: [integration_command_id], onDelete: Cascade)
  evidences                      integration_evidences[]

  @@unique([integration_command_id, attempt_no], map: "uq_integration_command_attempts_command_no")
  @@index([dispatch_status, created_at], map: "idx_integration_command_attempts_status")
}

/// Validated provider response or inbound event. Raw text is preserved losslessly.
model integration_evidences {
  integration_evidence_id        String                        @id @db.Uuid
  integration_command_id         String?                       @db.Uuid
  integration_command_attempt_id String?                       @db.Uuid
  provider                       String
  evidence_type                  String
  outcome                        String
  raw_payload_text               String?                       @db.Text
  raw_payload_digest             String
  normalized_result              Json?                         @db.JsonB
  occurred_at                    DateTime?                     @db.Timestamptz(3)
  received_at                    DateTime                      @default(now()) @db.Timestamptz(3)
  created_at                     DateTime                      @default(now()) @db.Timestamptz(3)
  command                        integration_commands?         @relation(fields: [integration_command_id], references: [integration_command_id], onDelete: SetNull)
  attempt                        integration_command_attempts? @relation(fields: [integration_command_attempt_id], references: [integration_command_attempt_id], onDelete: SetNull)
  projection_jobs                integration_projection_jobs[]

  @@index([provider, evidence_type, received_at], map: "idx_integration_evidences_provider_type")
  @@index([integration_command_id], map: "idx_integration_evidences_command")
}

/// Internal projection retry. It never repeats the external write.
model integration_projection_jobs {
  integration_projection_job_id String                @id @db.Uuid
  integration_evidence_id       String                @db.Uuid
  handler_key                   String
  projection_context            Json?                 @db.JsonB
  projection_status             String                @default("PENDING")
  attempt_count                 Int                   @default(0)
  lease_token                   String?               @db.Uuid
  claim_generation              Int                   @default(0)
  locked_until                  DateTime?             @db.Timestamptz(3)
  last_error_code               String?
  last_error_message            String?
  completed_at                  DateTime?             @db.Timestamptz(3)
  created_at                    DateTime              @default(now()) @db.Timestamptz(3)
  updated_at                    DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  evidence                      integration_evidences @relation(fields: [integration_evidence_id], references: [integration_evidence_id], onDelete: Cascade)

  @@unique([integration_evidence_id, handler_key], map: "uq_integration_projection_jobs_evidence_handler")
  @@index([projection_status, locked_until], map: "idx_integration_projection_jobs_claim")
}

/// Canonical append-only business audit event.
model domain_audit_events {
  domain_audit_event_id String                       @id @db.Uuid
  actor_user_id         Int?
  action                String
  aggregate_type        String
  aggregate_id          String
  operation_key         String?
  event_type            String
  occurred_at           DateTime                     @default(now()) @db.Timestamptz(3)
  created_at            DateTime                     @default(now()) @db.Timestamptz(3)
  changes               domain_audit_event_changes[]

  @@index([aggregate_type, aggregate_id, occurred_at], map: "idx_domain_audit_events_aggregate")
  @@index([actor_user_id, occurred_at], map: "idx_domain_audit_events_actor")
  @@index([operation_key], map: "idx_domain_audit_events_operation_key")
}

/// Allowlisted scalar changes attached to a canonical audit event.
model domain_audit_event_changes {
  domain_audit_event_change_id String              @id @db.Uuid
  domain_audit_event_id        String              @db.Uuid
  field_path                   String
  before_value                 String?             @db.Text
  after_value                  String?             @db.Text
  created_at                   DateTime            @default(now()) @db.Timestamptz(3)
  event                        domain_audit_events @relation(fields: [domain_audit_event_id], references: [domain_audit_event_id], onDelete: Cascade)

  @@unique([domain_audit_event_id, field_path], map: "uq_domain_audit_event_changes_field")
  @@index([field_path], map: "idx_domain_audit_event_changes_field")
}
