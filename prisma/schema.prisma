  package_group_id               Int
  issue_sequence                 Int
  revision_no                    Int                                  @default(1)
  item_status                    String                               @default("PENDING")
  carrier_shipment_id            Int?                                 @unique(map: "uq_carrier_invoice_issue_items_carrier_shipment")
  tracking_number_snapshot       String?
  result_code                    String?
  result_message                 String?
  label_print_status             String                               @default("NOT_PRINTED")
  label_payload_hash             String?
  label_print_attempt_no         Int                                  @default(0)
  label_print_count              Int                                  @default(0)
  label_last_spooled_at          DateTime?                            @db.Timestamptz(3)
  label_confirmed_at             DateTime?                            @db.Timestamptz(3)
  label_last_error_code          String?
  label_last_error_message       String?
  created_at                     DateTime                             @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime                             @default(now()) @updatedAt @db.Timestamptz(3)
