  @@index([package_group_id], map: "idx_carrier_invoice_issue_items_package_group")
  @@index([item_status], map: "idx_carrier_invoice_issue_items_status")
  @@index([label_print_status], map: "idx_carrier_invoice_issue_items_label_status")
}

