generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// QuickHack model: 기기 실물의 마스터 데이터이며 모든 검수/재고/주문/반품 흐름의 중심 PG를 보관합니다.
model devices {
  revision                         Int                                   @default(0)
  device_id                        Int                                   @id @default(autoincrement())
  pg_no                            String                                @unique(map: "uq_devices_1")
  imei                             String?                               @unique(map: "uq_devices_2")
  adb_serial                       String?                               @unique(map: "uq_devices_3")
  model                            String
  model_code                       String?
  model_seq                        Int?
  storage                          String?
  color                            String?
  sale_grade                       String?
  warranty                         String?
  inventory_sku_id                 Int?
  created_at                       DateTime                              @default(now()) @db.Timestamptz(3)
  updated_at                       DateTime                              @default(now()) @updatedAt @db.Timestamptz(3)
  inventory_sku                    inventory_skus?                       @relation(fields: [inventory_sku_id], references: [inventory_sku_id], onDelete: Restrict)
  inbounds                         inbounds[]
  inspections                      inspections[]
  inventory                        inventory?
  order_items                      order_items[]
  match_worker_allocations         match_worker_allocation[]
  sales_records                    sales_records[]
  sales_channel_write_requests     sales_channel_write_requests[]
  sales_channel_write_targets      sales_channel_write_request_targets[]
  shipment_address_change_works    shipment_address_change_work[]
  inventory_audit_location_changes inventory_audit_location_changes[]
  supply_consumption_events        supply_consumption_events[]

  @@unique([model, model_seq], map: "uq_devices_4")
  @@index([model_code], map: "idx_devices_model_code")
  @@index([model, model_seq], map: "idx_devices_model_seq")
  @@index([pg_no], map: "idx_devices_pg_no")
  @@index([inventory_sku_id], map: "idx_devices_inventory_sku_id")
  @@index([updated_at, device_id], map: "idx_devices_updated_latest")
}

/// QuickHack model: 입고 차수, 매입처, 매입가 등 실물 입고 업무 정보를 PG 기준으로 보관합니다.
model inbounds {
  revision                          Int                   @default(0)
  inbound_id                        Int                   @id @default(autoincrement())
  pg_no                             String
  inbound_batch_id                  Int?
  supplier_name                     String?
  purchase_price                    Int?
  purchase_price_reference_rate_id  Int?
  purchase_price_reference_amount   Int?
  purchase_price_entry_mode         String?
  received_at                       DateTime?             @db.Timestamptz(3)
  price_agreed_at                   DateTime?             @db.Timestamptz(3)
  supplier_returned_at              DateTime?             @db.Timestamptz(3)
  inbound_status                    String                @default("RECEIVED")
  note                              String?
  created_at                        DateTime              @default(now()) @db.Timestamptz(3)
  updated_at                        DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  purchase_price_updated_by_user_id Int?
  purchase_price_updated_at         DateTime?             @db.Timestamptz(3)
  devices                           devices               @relation(fields: [pg_no], references: [pg_no])
  inbound_batch                     inbound_batches?      @relation(fields: [inbound_batch_id], references: [inbound_batch_id], onDelete: Restrict)
  users                             users?                @relation(fields: [purchase_price_updated_by_user_id], references: [user_id])
  purchase_price_reference_rate     purchase_price_rates? @relation("InboundPurchasePriceReference", fields: [purchase_price_reference_rate_id], references: [purchase_price_rate_id], onDelete: SetNull)
  inspections                       inspections[]         @relation("InboundInspections")
  sales_records                     sales_records[]       @relation("SalesRecordPurchaseInbound")

  @@index([supplier_name], map: "idx_inbounds_supplier_name")
  @@index([inbound_batch_id], map: "idx_inbounds_inbound_batch_id")
  @@index([pg_no], map: "idx_inbounds_pg_no")
  @@index([pg_no, inbound_id], map: "idx_inbounds_pg_history")
  @@index([inbound_status], map: "idx_inbounds_status")
  @@index([inbound_status, pg_no, inbound_id], map: "idx_inbounds_status_pg_latest")
  @@index([purchase_price_updated_by_user_id], map: "idx_inbounds_purchase_price_updated_by_user_id")
  @@index([purchase_price_reference_rate_id], map: "idx_inbounds_purchase_price_reference_rate_id")
}

/// QuickHack model: 입고 업무일자별 차수 번호, 예정 대수, 메모를 보관합니다.
model inbound_batches {
  revision           Int        @default(0)
  inbound_batch_id   Int        @id @default(autoincrement())
  batch_date         DateTime   @db.Date
  batch_no           Int
  expected_quantity  Int
  note               String?
  created_by_user_id Int?
  created_at         DateTime   @default(now()) @db.Timestamptz(3)
  updated_at         DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  users              users?     @relation(fields: [created_by_user_id], references: [user_id], onDelete: SetNull)
  inbounds           inbounds[]

  @@unique([batch_date, batch_no], map: "uq_inbound_batches_date_no")
  @@index([batch_date], map: "idx_inbound_batches_batch_date")
  @@index([batch_no], map: "idx_inbound_batches_batch_no")
  @@index([expected_quantity], map: "idx_inbound_batches_expected_quantity")
  @@index([created_by_user_id], map: "idx_inbound_batches_created_by_user_id")
}

/// QuickHack model: 외관 검수와 기능 검수의 이력을 별도 기록으로 남기는 검수 이력 테이블입니다.
model inspections {
  revision                     Int       @default(0)
  inspection_id                Int       @id @default(autoincrement())
  pg_no                        String
  inbound_id                   Int?
  inspection_type              String    @default("APPEARANCE")
  inspection_round             Int       @default(1)
  inspection_result            String?
  source_type                  String    @default("INBOUND")
  coupang_return_allocation_id Int?
  checked_by_user_id           Int?
  checked_at                   DateTime? @db.Timestamptz(3)
  appearance_grade             String?
  appearance_defect            String?
  function_defect              String?
  return_yn                    String    @default("N")
  csc                          String?
  first_call_date              DateTime? @db.Date
  appearance_worker            String?
  function_worker              String?
  appearance_checked_at        DateTime? @db.Timestamptz(3)
  function_checked_at          DateTime? @db.Timestamptz(3)
  note                         String?
  created_at                   DateTime  @default(now()) @db.Timestamptz(3)
  devices                      devices   @relation(fields: [pg_no], references: [pg_no])
  inbound                      inbounds? @relation("InboundInspections", fields: [inbound_id], references: [inbound_id], onDelete: Restrict)

  @@index([pg_no], map: "idx_inspections_pg_no")
  @@index([pg_no, inspection_id], map: "idx_inspections_pg_history")
  @@index([pg_no, inspection_type, inspection_id], map: "idx_inspections_pg_type_latest")
  @@index([inbound_id], map: "idx_inspections_inbound_id")
  @@index([inspection_type], map: "idx_inspections_type")
  @@index([source_type, coupang_return_allocation_id], map: "idx_inspections_source_return_allocation")
  @@index([checked_by_user_id], map: "idx_inspections_checked_by_user_id")
}

/// QuickHack model: 현재 판매 가능 여부와 위치 등 기기별 현 재고 상태를 빠르게 조회하기 위한 테이블입니다.
model inventory {
  revision         Int       @default(0)
  inventory_id     Int       @id @default(autoincrement())
  pg_no            String    @unique(map: "uq_inventory_1")
  inventory_status String
  location         String?
  stocked_at       DateTime? @db.Timestamptz(3)
  created_at       DateTime  @default(now()) @db.Timestamptz(3)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  devices          devices   @relation(fields: [pg_no], references: [pg_no])

  @@index([inventory_status], map: "idx_inventory_status")
  @@index([inventory_status, pg_no], map: "idx_inventory_status_pg")
  @@index([pg_no], map: "idx_inventory_pg_no")
}

/// QuickHack model: current inventory quantity by normalized sellable attributes and inventory status.
model inventory_quantity_balances {
  inventory_quantity_balance_id Int                            @id @default(autoincrement())
  inventory_sku_id              Int
  inventory_status              String
  quantity                      Int                            @default(0)
  version                       Int                            @default(0)
  last_movement_at              DateTime?                      @db.Timestamptz(3)
  created_at                    DateTime                       @default(now()) @db.Timestamptz(3)
  updated_at                    DateTime                       @default(now()) @updatedAt @db.Timestamptz(3)
  inventory_sku                 inventory_skus                 @relation(fields: [inventory_sku_id], references: [inventory_sku_id], onDelete: Restrict)
  movements                     inventory_quantity_movements[]

  @@unique([inventory_sku_id, inventory_status], map: "uq_inventory_quantity_balances_sku_status")
  @@index([inventory_status, quantity], map: "idx_inventory_quantity_balances_status_quantity")
  @@index([inventory_sku_id, quantity], map: "idx_inventory_quantity_balances_sku_quantity")
  @@index([updated_at], map: "idx_inventory_quantity_balances_updated_at")
}

/// QuickHack model: append-only inventory quantity ledger for every balance change.
model inventory_quantity_movements {
  inventory_quantity_movement_id Int                         @id @default(autoincrement())
  inventory_quantity_balance_id  Int
  operation_key                  String
  idempotency_key                String                      @unique(map: "uq_inventory_quantity_movements_idempotency_key")
  movement_type                  String
  pg_no                          String?
  quantity_delta                 Int
  before_quantity                Int
  after_quantity                 Int
  source_type                    String
  source_id                      String?
  reason                         String?
  actor_user_id                  Int?
  worker_job_id                  Int?
  occurred_at                    DateTime                    @default(now()) @db.Timestamptz(3)
  created_at                     DateTime                    @default(now()) @db.Timestamptz(3)
  balance                        inventory_quantity_balances @relation(fields: [inventory_quantity_balance_id], references: [inventory_quantity_balance_id], onDelete: Restrict)
  actor_user                     users?                      @relation("InventoryQuantityMovementActor", fields: [actor_user_id], references: [user_id], onDelete: Restrict)
  worker_job                     server_worker_jobs?         @relation(fields: [worker_job_id], references: [worker_job_id], onDelete: Restrict)

  @@index([inventory_quantity_balance_id, occurred_at], map: "idx_inventory_quantity_movements_balance_time")
  @@index([operation_key], map: "idx_inventory_quantity_movements_operation_key")
  @@index([movement_type, occurred_at], map: "idx_inventory_quantity_movements_type_time")
  @@index([source_type, source_id], map: "idx_inventory_quantity_movements_source")
  @@index([pg_no], map: "idx_inventory_quantity_movements_pg_no")
  @@index([actor_user_id], map: "idx_inventory_quantity_movements_actor_user_id")
  @@index([worker_job_id], map: "idx_inventory_quantity_movements_worker_job_id")
  @@index([occurred_at], map: "idx_inventory_quantity_movements_occurred_at")
}

/// QuickHack model: 판매 가능 재고 등록 시 모델별 고유번호를 순차 발급하기 위한 카운터 테이블입니다.
model model_sequences {
  model      String   @id
  last_seq   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

/// QuickHack model: 기존 단순 주문 구조에서 주문별 상품 라인을 보관하는 호환용 테이블입니다.
model order_items {
  order_item_id      Int      @id @default(autoincrement())
  order_id           Int
  pg_no              String?
  sale_product_name  String
  sale_price         Int?
  quantity           Int      @default(1)
  matched_model      String?
  matched_storage    String?
  matched_color      String?
  matched_sale_grade String?
  match_status       String   @default("UNMATCHED")
  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  devices            devices? @relation(fields: [pg_no], references: [pg_no])
  orders             orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([match_status], map: "idx_order_items_match_status")
  @@index([pg_no], map: "idx_order_items_pg_no")
  @@index([pg_no, order_item_id], map: "idx_order_items_pg_history")
  @@index([order_id], map: "idx_order_items_order_id")
}

/// QuickHack model: 기존 단순 주문 구조에서 플랫폼 주문 헤더 정보를 보관하는 호환용 테이블입니다.
model orders {
  order_id          Int           @id @default(autoincrement())
  platform          String
  platform_order_id String
  ordered_at        DateTime?     @db.Timestamptz(3)
  buyer_name        String?
  receiver_name     String?
  phone             String?
  shipping_address  String?
  shipping_memo     String?
  order_status      String        @default("NEW")
  created_at        DateTime      @default(now()) @db.Timestamptz(3)
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  order_items       order_items[]

  @@unique([platform, platform_order_id], map: "uq_orders_1")
  @@index([ordered_at], map: "idx_orders_ordered_at")
  @@index([platform, platform_order_id], map: "idx_orders_platform_order_id")
}

/// QuickHack model: 직원 로그인 계정, 업무 권한, 개발자 권한을 보관합니다.
model users {
  revision                                Int                                         @default(0)
  credential_revision                     Int                                         @default(0)
  user_id                                 Int                                         @id @default(autoincrement())
  username                                String                                      @unique(map: "uq_users_1")
  password_hash                           String
  must_change_password                    Int                                         @default(0)
  role                                    String
  is_developer                            Int                                         @default(0)
  mobile_packing_enabled                  Int                                         @default(0)
  is_active                               Int                                         @default(1)
  created_at                              DateTime                                    @default(now()) @db.Timestamptz(3)
  updated_at                              DateTime                                    @default(now()) @updatedAt @db.Timestamptz(3)
  mobile_registered_devices               mobile_registered_devices[]                 @relation("MobileRegisteredDeviceUser")
  mobile_registered_devices_registered    mobile_registered_devices[]                 @relation("MobileRegisteredDeviceRegisteredBy")
  mobile_registered_devices_revoked       mobile_registered_devices[]                 @relation("MobileRegisteredDeviceRevokedBy")
  employee_profiles                       employee_profiles?
  user_preferences                        user_preferences?
  desktop_notification_recipients         desktop_notification_recipients[]
  user_shortcut_bindings                  user_shortcut_bindings[]
  employee_activity_logs                  employee_activity_logs[]
  manual_order_match_receipts             manual_order_match_selection_receipts[]     @relation("ManualOrderMatchReceiptIssuedTo")
  manual_order_match_intent_leases         manual_order_match_intent_leases[]           @relation("ManualOrderMatchIntentLeaseOwner")
  manual_recoveries_started               order_matching_work_queue[]                 @relation("ManualOrderMatchRecoveryStartedBy")
  inbounds                                inbounds[]
  inbound_batches                         inbound_batches[]
  product_camera_check_rules              product_camera_check_rules[]
  product_criteria_options                product_criteria_options[]
  product_criteria_option_links           product_criteria_option_links[]
  inventory_skus_created                  inventory_skus[]                            @relation("InventorySkuCreatedBy")
  inventory_skus_updated                  inventory_skus[]                            @relation("InventorySkuUpdatedBy")
  sales_offers_created                    sales_offers[]                              @relation("SalesOfferCreatedBy")
  sales_offers_updated                    sales_offers[]                              @relation("SalesOfferUpdatedBy")
  sales_channel_product_mappings_mapped   sales_channel_product_mappings[]            @relation("SalesChannelProductMappingMappedBy")
  purchase_price_rates                    purchase_price_rates[]
  server_job_logs                         server_job_logs[]
  client_http_trace_observations_reported client_http_trace_observations[]            @relation("ClientHttpTraceObservationReportedBy")
  server_worker_jobs                      server_worker_jobs[]
  supplies_updated                        supplies[]                                  @relation("SupplyUpdatedBy")
  supply_consumption_rules_updated        supply_consumption_rules[]                  @relation("SupplyConsumptionRuleUpdatedBy")
  supply_consumption_events_created       supply_consumption_events[]                 @relation("SupplyConsumptionEventCreatedBy")
  supply_forecast_snapshots_created       supply_forecast_snapshots[]                 @relation("SupplyForecastCreatedBy")
  supply_reorder_requests_created         supply_reorder_requests[]                   @relation("SupplyReorderCreatedBy")
  supply_reorder_requests_approved        supply_reorder_requests[]                   @relation("SupplyReorderApprovedBy")
  supply_stock_movements_created          supply_stock_movements[]                    @relation("SupplyMovementCreatedBy")
  inventory_audit_sessions_created        inventory_audit_sessions[]                  @relation("InventoryAuditSessionCreatedBy")
  inventory_quantity_movements_actor      inventory_quantity_movements[]              @relation("InventoryQuantityMovementActor")
  shipment_list_print_batches_created     sales_channel_shipment_list_print_batches[] @relation("ShipmentListPrintBatchCreatedBy")
  shipment_address_change_works_processed shipment_address_change_work[]              @relation("ShipmentAddressChangeProcessedBy")
  carrier_invoice_replacements_requested  carrier_invoice_replacement_works[]         @relation("CarrierInvoiceReplacementRequestedBy")
  carrier_invoice_replacements_resolved   carrier_invoice_replacement_works[]         @relation("CarrierInvoiceReplacementResolvedBy")
  carrier_integration_settings_updated    carrier_integration_settings[]              @relation("CarrierIntegrationSettingsUpdatedBy")
  coupang_return_allocations_linked       coupang_return_allocation[]                 @relation("CoupangReturnAllocationLinkedBy")
  sales_channel_write_requests_requested  sales_channel_write_requests[]              @relation("SalesChannelWriteRequestedBy")
  sales_channel_write_requests_verified   sales_channel_write_requests[]              @relation("SalesChannelWriteVerifiedBy")
  sales_channel_write_controls_paused     sales_channel_write_controls[]              @relation("SalesChannelWriteControlPausedBy")
  sales_channel_write_controls_resumed    sales_channel_write_controls[]              @relation("SalesChannelWriteControlResumedBy")
  user_sessions                           user_sessions[]
  user_totp_credentials                   user_totp_credentials?
  user_totp_recovery_codes                user_totp_recovery_codes[]

  @@index([is_active], map: "idx_users_is_active")
  @@index([is_developer], map: "idx_users_is_developer")
  @@index([mobile_packing_enabled], map: "idx_users_mobile_packing_enabled")
  @@index([role], map: "idx_users_role")
  @@index([username], map: "idx_users_username")
}

/// QuickHack model: 모바일 포장 검수 앱을 계정과 ADB 등록 증거에 연결합니다.
model mobile_registered_devices {
  registration_revision          Int       @default(0)
  device_id                      Int       @id @default(autoincrement())
  user_id                        Int
  label                          String?
  adb_serial_hmac                String
  adb_serial_preview             String
  registration_state             String    @default("PROVISIONING")
  provisioning_token_hash        String?   @unique(map: "uq_mobile_registered_devices_provisioning_token_hash")
  provisioning_expires_at        DateTime? @db.Timestamptz(3)
  app_instance_id_hash           String?
  device_public_key_spki         String?
  device_public_key_fingerprint  String?
  device_token_hash              String?   @unique(map: "uq_mobile_registered_devices_token_hash")
  user_credential_revision       Int?
  instance_epoch                 Int?
  activated_at                   DateTime? @db.Timestamptz(3)
  registered_by_user_id          Int?
  revoked_by_user_id             Int?
  revoked_at                     DateTime? @db.Timestamptz(3)
  last_seen_at                   DateTime? @db.Timestamptz(3)
  created_at                     DateTime  @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user                           users     @relation("MobileRegisteredDeviceUser", fields: [user_id], references: [user_id], onDelete: Cascade)
  registered_by                  users?    @relation("MobileRegisteredDeviceRegisteredBy", fields: [registered_by_user_id], references: [user_id], onDelete: SetNull)
  revoked_by                     users?    @relation("MobileRegisteredDeviceRevokedBy", fields: [revoked_by_user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id, device_id], map: "idx_mobile_registered_devices_user_page")
  @@index([adb_serial_hmac], map: "idx_mobile_registered_devices_adb_serial_hmac")
  @@index([registration_state, device_id], map: "idx_mobile_registered_devices_state_page")
  @@index([last_seen_at], map: "idx_mobile_registered_devices_last_seen_at")
  @@index([registered_by_user_id], map: "idx_mobile_registered_devices_registered_by")
  @@index([revoked_by_user_id], map: "idx_mobile_registered_devices_revoked_by")
}

model user_totp_credentials {
  credential_id              Int                          @id @default(autoincrement())
  user_id                    Int                          @unique(map: "uq_user_totp_credentials_1")
  secret_ciphertext          String
  secret_iv                  String
  secret_auth_tag            String
  enabled                    Int                          @default(0)
  verified_at                DateTime?                    @db.Timestamptz(3)
  last_used_step             Int?
  failed_count               Int                          @default(0)
  locked_until               DateTime?                    @db.Timestamptz(3)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(3)
  updated_at                 DateTime                     @default(now()) @updatedAt @db.Timestamptz(3)
  users                      users                        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_sensitive_auth_grants user_sensitive_auth_grants[]

  @@index([user_id], map: "idx_user_totp_credentials_user_id")
  @@index([enabled], map: "idx_user_totp_credentials_enabled")
  @@index([locked_until], map: "idx_user_totp_credentials_locked_until")
}

model user_totp_recovery_codes {
  recovery_code_id Int       @id @default(autoincrement())
  user_id          Int
  code_hash        String    @unique(map: "uq_user_totp_recovery_codes_1")
  used_at          DateTime? @db.Timestamptz(3)
  created_at       DateTime  @default(now()) @db.Timestamptz(3)
  users            users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_totp_recovery_codes_user_id")
  @@index([used_at], map: "idx_user_totp_recovery_codes_used_at")
}

/// QuickHack model: 로그인 계정에 연결되는 직원 표시명, 연락처, 생일, 입사일 같은 인사 기본 정보를 보관합니다.
model employee_profiles {
  profile_id   Int       @id @default(autoincrement())
  user_id      Int       @unique(map: "idx_employee_profiles_user_id_unique")
  display_name String
  phone        String?
  email        String?
  birth_date   DateTime? @db.Date
  hire_date    DateTime? @db.Date
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([display_name], map: "idx_employee_profiles_display_name")
}

