  package_group                       shipment_package_groups        @relation(fields: [package_group_id], references: [package_group_id], onDelete: Restrict)
  shipment_address_change_work        shipment_address_change_work?  @relation(fields: [shipment_address_change_work_id], references: [shipment_address_change_work_id], onDelete: SetNull)
