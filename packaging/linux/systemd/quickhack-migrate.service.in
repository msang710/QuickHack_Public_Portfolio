[Unit]
Description=QuickHack PostgreSQL migration
Requires=@QUICKHACK_POSTGRESQL_UNIT@
After=@QUICKHACK_POSTGRESQL_UNIT@
Before=@QUICKHACK_APPLICATION_UNIT@

[Service]
Type=oneshot
User=@QUICKHACK_APPLICATION_USER@
Group=@QUICKHACK_APPLICATION_GROUP@
ExecStart=@QUICKHACK_NODE_EXECUTABLE@ @QUICKHACK_MIGRATION_ENTRY@ --runtime-config @QUICKHACK_RUNTIME_CONFIG@
@QUICKHACK_MIGRATOR_CREDENTIAL_DIRECTIVES@
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@QUICKHACK_STATE_DIR@ @QUICKHACK_LOG_DIR@
