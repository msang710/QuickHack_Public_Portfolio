d @QUICKHACK_CONFIG_DIR@ 0750 root @QUICKHACK_APPLICATION_GROUP@ -
d /var/lib/quickhack/security 0700 root root -
d @QUICKHACK_DATA_DIR@ 0750 @QUICKHACK_APPLICATION_USER@ @QUICKHACK_APPLICATION_GROUP@ -
a+ @QUICKHACK_DATA_DIR@ - - - - u:@QUICKHACK_POSTGRESQL_USER@:--x
d @QUICKHACK_STATE_DIR@ 0750 @QUICKHACK_APPLICATION_USER@ @QUICKHACK_APPLICATION_GROUP@ -
d @QUICKHACK_LOG_DIR@ 0750 @QUICKHACK_APPLICATION_USER@ @QUICKHACK_APPLICATION_GROUP@ -
d @QUICKHACK_CACHE_DIR@ 0750 @QUICKHACK_APPLICATION_USER@ @QUICKHACK_APPLICATION_GROUP@ -
