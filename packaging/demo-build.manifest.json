    "quickhack_server/platform/",
    "quickhack_client/platform/",
    "tools/platform/",
    "tools/initialize-https.ps1",
    "tools/quickhack-https-forwarding.mjs",
    "tools/quickhack-https-gateway.mjs",
    "tools/quickhack-shutdown-coordinator.mjs",
    "tools/quickhack-shutdown-coordinator.d.mts",
    "tools/server-console-qhkey.mjs",
    "tools/server-console-qhkey-common.mjs",
    "tools/server-console-qhkey-demonstration.mjs",
    "tools/server-console-qhkey-operational.mjs",
    "tools/server-console-tls.mjs",
    "tools/trust-bundle.mjs",
    "tools/server-console.mjs",
    "tools/server-console-core.mjs",
    "tools/server-console-demonstration.mjs",
    "tools/server-console-operational.mjs",
    "tools/quickhack-operator.mjs",
    "tools/quickhack-operator-core.mjs",
    "tools/operator-direct-one-shot.mjs",
    "tools/operator-restore-handoff.mjs",
    "tools/client-runtime-plan.mjs",
    "tools/qhkey-authorize.mjs"
