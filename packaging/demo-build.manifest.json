  "packageOnly": [
    "release/launchers/",
    "tools/node-portable/",
    "runtime/postgresql/",
    "platform-tools/"
  ],
  "demoOnly": [
    "mock_server/",
    "mock.cmd",
    "logen-mock.cmd"
  ],
  "exclude": [
    "tests/",
    "specs/",
    ".agents/",
    "portfolio/",
    "docs/",
    "screenshots/",
    ".tmp/",
    ".tmp-*/",
    ".codex-temp/",
    "logs/",
    "runtime-logs/",
    ".next/",
    "node_modules/",
    "generated/",
    "reports/",
    "test-results/",
    "release/",
    "database/qhkey/",
    "database/security/",
    "database/backups/",
    "mock_server/database/",
    "tools/dev/",
    "tools/docs/",
    "tsconfig.tsbuildinfo",
    "*.log",
    "*.key",
    "*.qhb",
    "*.qhkey"
  ],
  "entrypoints": {
    "demonstrationServer": "tools/server-console-demonstration.mjs",
    "demonstrationClient": "tools/client-runtime-launcher.mjs",
    "operationalServer": "tools/server-console-operational.mjs",
    "operationalClient": "tools/client-runtime-launcher.mjs",
    "windowsPackageScript": "packaging/windows/create-staging-package.mjs",
    "linuxPackageScript": "packaging/linux/create-staging-package.mjs"
  },
  "notes": [
    "Tag workflows publish four Windows installers and four CachyOS/Arch packages after the final integration gate.",
    "Windows server packages include PostgreSQL 18; Arch server packages use the exact system PostgreSQL 18 executable set.",
    "The demo client contains a loopback-only Next.js client runtime, portable Node.js, Android platform-tools, the native QuickHack-Demo-Client.exe launcher, icon, and central server URL configuration.",
    "ADB runs only in the client runtime on the staff PC; central server routes continue to reject ADB execution.",
    "Staged server and client artifacts reject privileged native adapters owned by the opposite runtime role.",
    "Official artifacts include immutable manifest and checksum metadata; portable ZIP staging is not published."
  ]
}
