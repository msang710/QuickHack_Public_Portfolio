{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "generated/prisma/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-client/types/**/*.ts",
    ".next-client/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tools/node-portable",
    "portfolio/**",
    "release/**",
    ".next-verify-*/**"
  ]
}
